<RCC>
    <qresource prefix="custom/img">
        <file alias="CustomAppIcon.jpg">res/Images/CustomAppIcon.jpg</file>
    </qresource>
    <qresource prefix="/fonts">
        <file alias="Abel-Regular">res/fonts/Abel-Regular.ttf</file>
    </qresource>
    <qresource prefix="/qml">
        <file alias="QGroundControl/ScreenTools/ScreenTools.qml">qml/QGroundControl/ScreenTools/ScreenTools.qml</file>
    </qresource>
