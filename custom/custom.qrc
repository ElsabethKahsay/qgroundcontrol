        <file alias="logo">res/Images/white_bg_logo.jpg</file>
    </qresource>
    <qresource prefix="qml/mission">
        <file alias="AddWaypointByBearingDialog.qml">qml/mission/AddWaypointByBearingDialog.qml</file>
