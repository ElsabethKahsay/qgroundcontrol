    </qresource>
    <qresource prefix="/qml/QGroundControl/Controls">
        <file alias="FlyViewToolBar.qml">qml/QGroundControl/Controls/FlyViewToolBar.qml</file>
    </qresource>
    <qresource prefix="/qml/QGroundControl/FlightMap">
        <file alias="QGCVideoBackground.qml">qml/QGCVideoBackground.qml</file>
    </qresource>
    <qresource prefix="qml/pages">
        <file alias="Home.qml">qml/pages/Home.qml</file>
        <file alias="VehicleSelect.qml">qml/pages/VehicleSelect.qml</file>
        <file alias="PreFlightChecklist.qml">qml/pages/PreFlightChecklist.qml</file>
        <file alias="PayloadCheck.qml">qml/pages/PayloadCheck.qml</file>
        <file alias="FinalChecks.qml">qml/pages/FinalChecks.qml</file>
        <file alias="LaunchReady.qml">qml/pages/LaunchReady.qml</file>
        <file alias="GimbalTest.qml">qml/pages/GimbalTest.qml</file>
        <file alias="MaintenancePage.qml">qml/pages/MaintenancePage.qml</file>
        <file alias="TemplateEditor.qml">qml/pages/TemplateEditor.qml</file>
        <file alias="TemplateManager.qml">qml/pages/TemplateManager.qml</file>
        <file alias="PostFlightSummary.qml">qml/pages/PostFlightSummary.qml</file>
        <file alias="PreflightSettings.qml">qml/pages/PreflightSettings.qml</file>
        <file alias="VehicleManagement.qml">qml/pages/VehicleManagement.qml</file>
    </qresource>
    <qresource prefix="qml/singletons">
        <file alias="Colors.qml">qml/singletons/Colors.qml</file>
        <file alias="Config.qml">qml/singletons/Config.qml</file>
        <file alias="VehicleTelemetry.qml">qml/singletons/VehicleTelemetry.qml</file>
    </qresource>
    <qresource prefix="qml/analyze">
